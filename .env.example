# CodeDNA Faz 9 — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp gerçek değerleri girin:
#   cp .env.example .env
# .env dosyası GİT'E EKLENMEZ (.gitignore'dadır)

# ---------------------------------------------------------------------------
# Kimlik Doğrulama
# ---------------------------------------------------------------------------
# JWT imzalama anahtarı — production'da güçlü rastgele değer kullanın
# Örnek: python3 -c "import secrets; print(secrets.token_hex(32))"
CODEDNA_JWT_SECRET=degistir-bunu-guclu-rastgele-deger

# ---------------------------------------------------------------------------
# Lemon Squeezy Ödeme Entegrasyonu
# ---------------------------------------------------------------------------
# Lemon Squeezy API anahtarı (https://app.lemonsqueezy.com/settings/api)
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here

# Lemon Squeezy webhook secret (Settings > Webhooks > Secret)
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret_here

# Lemon Squeezy mağaza ID'si
LEMONSQUEEZY_STORE_ID=your_store_id_here

# Plan başına Lemon Squeezy variant ID'leri
LS_VARIANT_PRO=your_pro_variant_id
LS_VARIANT_TEAM=your_team_variant_id
LS_VARIANT_ENTERPRISE=your_enterprise_variant_id

# ---------------------------------------------------------------------------
# CodeDNA Servis Yapılandırması
# ---------------------------------------------------------------------------
# API sunucu adresi (dashboard için)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth DB yolu (repo db'sinden ayrı tutulan kullanıcı veritabanı)
# Varsayılan: ~/.codedna/auth.db
# CODEDNA_AUTH_DB_PATH=/özel/yol/auth.db
